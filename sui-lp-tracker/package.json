{
  "name": "sui-lp-tracker",
  "private": true,
  "version": "2.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/fix-dayjs-esm.mjs",
    "build": "node server/build-cron.mjs && tsc -b && vite build",
    "build:cron": "node server/build-cron.mjs",
    "snapshot:once": "vite-node --mode production scripts/portfolio-snapshot-once.ts",
    "lp-history:sync": "vite-node --mode production scripts/lp-history-sync-once.ts",
    "lp:unclaimed-parity": "vite-node --mode production scripts/lp-unclaimed-parity.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:smoke": "node scripts/vite-advisor-smoke.mjs",
    "typecheck": "tsc -b --pretty false",
    "probe:rpc": "node scripts/probe-sui-rpc-nodes.mjs",
    "spike:grpc-graphql": "node scripts/spike-sui-grpc-graphql.mjs"
  },
  "dependencies": {
    "@alphafi/alphalend-sdk": "^4.1.0",
    "@autopilot/cetus": "*",
    "@autopilot/engine": "*",
    "@cetusprotocol/common-sdk": "^1.4.3",
    "@cetusprotocol/dlmm-sdk": "^1.3.3",
    "@cetusprotocol/sui-clmm-sdk": "^1.4.9",
    "@grpc/grpc-js": "^1.14.4",
    "@mmt-finance/clmm-sdk": "^1.3.25",
    "@mysten/dapp-kit-react": "^2.1.43",
    "@mysten/sui": "2.36.0",
    "@naviprotocol/lending": "^2.0.12",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.101.2",
    "aftermath-ts-sdk": "^6.1.1",
    "axios": "^1.20.0",
    "blakejs": "^1.2.1",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3",
    "decimal.js": "^10.6.0",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "turbos-clmm-sdk": "^4.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.25.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
