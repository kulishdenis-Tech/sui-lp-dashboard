# Скопіюй у файл `.env` у цій папці і підстав власні значення.
# Після зміни .env обов'язково перезапусти `npm run dev`.

# ── Client (потрапляють у browser bundle через VITE_*) ─────────────────────

# RPC Sui (mainnet)
VITE_SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Dev only: OKX keys у браузері (локальний HMAC). У static prod використовуй serverless нижче.
VITE_OKX_API_KEY=
VITE_OKX_SECRET_KEY=
VITE_OKX_PASSPHRASE=

# Dev only: CoinGecko key у браузері. У prod — COINGECKO_API_KEY на Vercel/Netlify.
VITE_COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COINGECKO_PRO=1

# Опційно: кастомний Suiet coin list
# VITE_SUIET_COIN_LIST_URL=

# VITE_OKX_TIMEOUT_MS=60000
# VITE_OKX_RETRIES=2
# VITE_LP_CANDLES_URL=https://example.com/api/lp/pool-candles
# VITE_DEBUG_BLUEFIN=1
# VITE_LP_LIFECYCLE_INDEXER=1
# VITE_LP_LAZY_CLOSED=0

# ── Server-only (Vercel / Netlify Functions — без VITE_ префікса) ─────────

# OKX Web3 signed proxy (/api/okx)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# CoinGecko proxy (/api/coingecko)
COINGECKO_API_KEY=
# COINGECKO_PRO=1
