# Скопіюй у файл `.env` у цій папці і підстав власні значення.
# Після зміни .env обов'язково перезапусти `npm run dev`.

# ── Client (потрапляють у browser bundle через VITE_*) ─────────────────────

# RPC Sui (mainnet)
VITE_SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Portfolio reads (LP / Current / balances): gRPC default since v1.2.0 (Mysten public-good).
# SUI_DATA_TRANSPORT=grpc
# Optional multi-endpoint order (aliases). PublicNode is NOT default — Node gRPC-Web gets grpc-web-text rejection.
# SUI_GRPC_ENDPOINTS=mysten,publicnode
# PORTFOLIO_GRPC_PROBE_TIMEOUT_MS=4000
# PORTFOLIO_GRPC_CALL_TIMEOUT_MS=15000
# PORTFOLIO_GRPC_CALL_RETRIES=1
# PORTFOLIO_GRPC_COOLDOWN_AFTER_FAILURES=3
# PORTFOLIO_GRPC_ENDPOINT_COOLDOWN_MS=300000
# PORTFOLIO_LP_SOURCE_CONCURRENCY=4
# SUI_LP_ADVISOR_PROFILE=1

# Dev only: OKX keys у браузері (локальний HMAC). У static prod використовуй serverless нижче.
VITE_OKX_API_KEY=
VITE_OKX_SECRET_KEY=
VITE_OKX_PASSPHRASE=

# Dev only: CoinGecko Demo key у браузері. У prod — COINGECKO_API_KEY на Vercel (free Demo API).
VITE_COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx

# Опційно: кастомний Suiet coin list
# VITE_SUIET_COIN_LIST_URL=

# VITE_OKX_TIMEOUT_MS=60000
# VITE_OKX_RETRIES=2
# VITE_LP_CANDLES_URL=https://example.com/api/lp/pool-candles
# VITE_DEBUG_BLUEFIN=1
# VITE_LP_LIFECYCLE_INDEXER=1
# VITE_LP_LAZY_CLOSED=0

# ── Server-only (Vercel / Netlify Functions — без VITE_ префікса) ─────────

# OKX Web3 signed proxy (/api/okx) — free Web3 API keys
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# CoinGecko free Demo proxy (/api/coingecko)
COINGECKO_API_KEY=

# ── Server analytics (Supabase + GitHub Actions) ─────────────────────────────

# Comma-separated wallets to snapshot every 15 min (even when browser closed)
WATCH_WALLETS=0xff8a51f37daceef95619a7d31915868375329964bacea6c72811175d6a458da6,0x925efc24d39e9a1726b22ff6a869ffe107820d036d91e5a1775353c38e0644b9

# Supabase: Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron auth (optional; main cron is GitHub Actions)
CRON_SECRET=

# LP history sync (GHA): incremental by default; set 1 to re-enrich all closed
# LP_HISTORY_FULL_RESYNC=1
# Historical quote concurrency in Node (default 3)
# LP_HIST_QUOTE_CONCURRENCY=3

# Optional: public URL if not on Vercel (for cron self-callback to /api/*)
# SERVER_PUBLIC_URL=https://sui-lp-dashboard.vercel.app
