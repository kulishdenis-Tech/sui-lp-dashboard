{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "vite-plugin-activity-export.ts",
    "vite-plugin-advisor-state.ts",
    "vite-plugin-analytics-api.ts",
    "vite-plugin-api-stub.ts",
    "vite-plugin-coingecko-proxy.ts",
    "vite-plugin-local-snapshot-writer.ts",
    "vite-plugin-lp-candles.ts",
    "vite-plugin-okx-proxy.ts",
    "vite-plugin-pool-quote.ts",
    "vite-server-env.ts",
    "api/_lib/secrets.ts"
  ]
}
