# Default: observation only. Never put OWNER private keys here.
AUTOPILOT_MODE=MONITOR_ONLY

# Sui RPC / gRPC (read)
SUI_NETWORK=mainnet
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Whitelisted Cetus DLMM SUI/USDC pool object id (fill after discovery)
CETUS_DLMM_POOL_ID=

# Operator key ONLY for gas in AUTO_GUARDED — never hold trading capital
# OPERATOR_PRIVATE_KEY=

# SQLite
DATABASE_URL=file:./data/autopilot.db

# Dashboard
DASHBOARD_PORT=5190
